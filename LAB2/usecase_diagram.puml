@startuml
left to right direction

actor "Гість (Guest)" as Guest
actor "Авторизований Клієнт (Customer)" as Customer

Guest <|-- Customer : <<generalization>>

rectangle "Інтернет-магазин книг" {
    usecase "Перегляд каталогу книг" as UC1
    usecase "Авторизація в системі" as UC_Login
    usecase "Додавання книги до кошика" as UC2
    usecase "Оформлення замовлення (Checkout)" as UC3
}

Guest --> UC1
Guest --> UC_Login
Customer --> UC2
Customer --> UC3
@enduml